#!/usr/bin/env bash
set -euo pipefail

DEPLOY_ROOT="${MANTIS_DEPLOY_ROOT:-/opt/mantis}"
DEPLOY_ENV="${DEPLOY_ROOT}/deploy.env"
COMPOSE_FILE="${DEPLOY_ROOT}/compose.yaml"
STATE_DIR="${DEPLOY_ROOT}/state"
SERVICE_NAME="${MANTIS_SERVICE_NAME:-mantis}"
CONTAINER_NAME="${MANTIS_CONTAINER_NAME:-mantis}"
LOCK_FILE="${DEPLOY_ROOT}/.deploy.lock"

# The lifecycle contract THIS installed compose.yaml/mantis-deploy pair
# declares -- e.g. "the image's `mantis` CLI has a `serve` subcommand
# that runs as PID1 and produces the documented /readyz behavior" (#21).
# Bump this deliberately whenever a future change to compose.yaml's
# `command`/`healthcheck` (or an equivalent lifecycle-shape change)
# means an older image can no longer be assumed to work under it (#98).
# Never inferred from the image's own SemVer tag -- a 1.5.0 image and a
# 1.7.0 image differ in exactly this way (pre- vs post-#21 `mantis
# serve`), which SemVer alone doesn't tell you. See "Deployment contract
# compatibility" in docs/deployment.md.
DEPLOYMENT_CONTRACT_VERSION="1"

log() { printf '[mantis-deploy] %s\n' "$*"; }
err() { printf '[mantis-deploy] ERROR: %s\n' "$*" >&2; }
die() { err "$*"; exit 1; }

usage() {
  cat <<'USAGE'
Usage:
  mantis-deploy <tag>       Deploy an explicit GHCR tag (for example pr-46 or 1.0.0)
  mantis-deploy status      Show configured/running image and health state
  mantis-deploy rollback    Redeploy the previous known-good immutable image
  mantis-deploy help        Show this help

The tag "latest" is intentionally refused. A selected tag is pulled once,
resolved to an immutable digest, and that digest is what Docker Compose runs.
USAGE
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "Required command not found: $1"
}

read_env_value() {
  local key="$1" file="$2" line value
  line="$(grep -E "^${key}=" "$file" | tail -n 1 || true)"
  [[ -n "$line" ]] || return 1
  value="${line#*=}"
  if [[ "$value" == \"*\" && "$value" == *\" ]]; then
    value="${value:1:${#value}-2}"
  elif [[ "$value" == \'*\' && "$value" == *\' ]]; then
    value="${value:1:${#value}-2}"
  fi
  printf '%s' "$value"
}

set_env_value() {
  local key="$1" value="$2" file="$3" tmp
  tmp="$(mktemp "${file}.tmp.XXXXXX")"
  awk -v key="$key" -v value="$value" '
    BEGIN { found = 0 }
    index($0, key "=") == 1 { print key "=" value; found = 1; next }
    { print }
    END { if (!found) print key "=" value }
  ' "$file" >"$tmp"
  chmod --reference="$file" "$tmp" 2>/dev/null || true
  mv "$tmp" "$file"
}

read_state() {
  local name="$1"
  [[ -f "${STATE_DIR}/${name}" ]] || return 1
  cat "${STATE_DIR}/${name}"
}

write_state() {
  local name="$1" value="$2"
  printf '%s\n' "$value" >"${STATE_DIR}/${name}"
}

remove_state() { rm -f "${STATE_DIR}/$1"; }

validate_tag() {
  local tag="$1"
  [[ "$tag" != "latest" ]] || die "Refusing to deploy 'latest'; use an explicit PR, SHA, dev, or SemVer tag"
  [[ "$tag" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]] || die "Invalid Docker tag: ${tag}"
}

is_contract_compatible() {
  # A recorded deployment's contract is compatible with the currently
  # installed tooling only on an exact, explicit match -- never inferred
  # from the image's tag/SemVer, and never assumed for a blank/missing
  # value (legacy state predating contract tracking, or any other way
  # this could come back empty) (#98).
  local recorded_contract="$1"
  [[ -n "$recorded_contract" && "$recorded_contract" == "$DEPLOYMENT_CONTRACT_VERSION" ]]
}

compose() {
  docker compose --env-file "$DEPLOY_ENV" -f "$COMPOSE_FILE" "$@"
}

print_incompatible_rollback_recovery_hint() {
  # Deliberately never suggests `mantis-deploy <tag>` here: rollback is
  # digest-based specifically so a moving mutable tag (e.g. a rebuilt
  # `pr-100`) never changes what "previous known-good" means -- printing
  # that command as "recovery" would silently reintroduce exactly the
  # tag-drift problem digest-based rollback exists to prevent. There is
  # no `mantis-deploy` subcommand that accepts an already-resolved
  # digest ref directly (a deliberate scope decision, not an oversight,
  # for this change) -- the guidance below is a manual, one-off bypass
  # of mantis-deploy's own tracking, not a normal operation.
  local tag="$1" ref="$2"
  err "Manual recovery: ${ref} is the exact image last verified good for '${tag}' -- do NOT run 'mantis-deploy ${tag}' to restore it. That re-resolves the mutable tag '${tag}', which may now point at a different digest than ${ref}."
  err "After separately confirming ${ref} is actually compatible with the currently installed compose.yaml/mantis-deploy (e.g. by restoring a checkout of this tooling recorded under a matching contract), you can restore it directly, bypassing mantis-deploy's own tracking: set MANTIS_IMAGE_REF=${ref} (and MANTIS_DEPLOYED_TAG=${tag}) in ${DEPLOY_ENV}, then run: docker compose --env-file ${DEPLOY_ENV} -f ${COMPOSE_FILE} up -d --force-recreate ${SERVICE_NAME}"
  err "This bypasses mantis-deploy's health gate and state tracking -- verify readiness yourself, and expect 'mantis-deploy status' to look inconsistent until the next successful 'mantis-deploy <tag>' or 'mantis-deploy rollback' re-establishes state."
}

container_state() {
  docker inspect --format '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true
}

container_health() {
  docker inspect --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$CONTAINER_NAME" 2>/dev/null || true
}

running_image_ref() {
  docker inspect --format '{{.Config.Image}}' "$CONTAINER_NAME" 2>/dev/null || true
}

running_image_id() {
  docker inspect --format '{{.Image}}' "$CONTAINER_NAME" 2>/dev/null || true
}

wait_for_health() {
  # Only a Docker-reported "healthy" status promotes a deployment.
  # compose.yaml's healthcheck polls the real /readyz contract (#21),
  # so "healthy" here means readiness was actually proven, not merely
  # inferred. "none" -- no healthcheck metadata at all, e.g. a
  # misconfigured or missing `healthcheck:` stanza -- must fail
  # closed: it is deliberately *not* treated as success (unlike the
  # pre-#21 deployment model, where a container with no healthcheck at
  # all was reasonably treated as merely running). A container stuck
  # reporting "none" or "starting" simply runs out the clock below and
  # this function returns 1, exactly like a container that never
  # passes its healthcheck.
  local timeout="$1" interval="$2" deadline state health
  deadline=$((SECONDS + timeout))

  while (( SECONDS < deadline )); do
    state="$(container_state)"
    health="$(container_health)"

    case "$state" in
      exited|dead|removing) return 1 ;;
      running)
        [[ "$health" != "healthy" ]] || return 0
        [[ "$health" != "unhealthy" ]] || return 1
        ;;
    esac

    sleep "$interval"
  done

  return 1
}

resolve_digest_ref() {
  local tagged_ref="$1" repository="$2" digest_ref
  digest_ref="$({ docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "$tagged_ref" 2>/dev/null || true; } \
    | awk -v prefix="${repository}@" 'index($0, prefix) == 1 { print; exit }')"
  [[ -n "$digest_ref" ]] || die "Pulled ${tagged_ref}, but Docker did not report an immutable RepoDigest"
  printf '%s' "$digest_ref"
}

emit_event() {
  # deployment_contract is always this installed tooling's own active
  # contract version (never the target image's) -- a fixed,
  # low-cardinality string, never a secret. It tells a reader which
  # contract regime was in effect for this event, which matters most
  # for outcome=refused_incompatible_contract (#98).
  local action="$1" outcome="$2" tag="$3" image_ref="$4" timestamp json
  timestamp="$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
  json="{\"event\":\"mantis_deployment\",\"timestamp\":\"${timestamp}\",\"action\":\"${action}\",\"outcome\":\"${outcome}\",\"requested_tag\":\"${tag}\",\"image_ref\":\"${image_ref}\",\"deployment_contract\":\"${DEPLOYMENT_CONTRACT_VERSION}\",\"host\":\"$(hostname -s)\"}"

  command -v logger >/dev/null 2>&1 && logger -t mantis-deploy -- "$json" || true

  # Also write successful deployment events into the container's stdout so
  # the existing Alloy Docker source ships them to Loki.
  if [[ "$(container_state)" == "running" ]]; then
    printf '%s\n' "$json" | docker exec -i "$CONTAINER_NAME" /bin/sh -c 'cat >/proc/1/fd/1' >/dev/null 2>&1 || true
  fi
}

ensure_layout() {
  [[ -f "$COMPOSE_FILE" ]] || die "Missing ${COMPOSE_FILE}; install deploy/standalone/compose.yaml first"
  [[ -f "$DEPLOY_ENV" ]] || die "Missing ${DEPLOY_ENV}; copy deploy.env.example and configure it first"
  mkdir -p "$STATE_DIR"
  touch "$LOCK_FILE"

  require_command docker
  docker compose version >/dev/null 2>&1 || die "Docker Compose v2 is required (docker compose)"
  require_command flock
}

image_repository() {
  local repository
  repository="${MANTIS_IMAGE_REPOSITORY:-$(read_env_value MANTIS_IMAGE_REPOSITORY "$DEPLOY_ENV" || true)}"
  [[ -n "$repository" ]] || die "MANTIS_IMAGE_REPOSITORY is not set in ${DEPLOY_ENV}"
  [[ "$repository" =~ ^[A-Za-z0-9._/-]+$ ]] || die "Invalid image repository: ${repository}"
  printf '%s' "$repository"
}

health_timeout() {
  local value
  value="${MANTIS_HEALTH_TIMEOUT_SECONDS:-$(read_env_value MANTIS_HEALTH_TIMEOUT_SECONDS "$DEPLOY_ENV" || true)}"
  value="${value:-60}"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || die "MANTIS_HEALTH_TIMEOUT_SECONDS must be a positive integer"
  printf '%s' "$value"
}

health_interval() {
  local value
  value="${MANTIS_HEALTH_INTERVAL_SECONDS:-$(read_env_value MANTIS_HEALTH_INTERVAL_SECONDS "$DEPLOY_ENV" || true)}"
  value="${value:-2}"
  [[ "$value" =~ ^[1-9][0-9]*$ ]] || die "MANTIS_HEALTH_INTERVAL_SECONDS must be a positive integer"
  printf '%s' "$value"
}

apply_image() {
  local tag="$1" immutable_ref="$2" timeout interval
  timeout="$(health_timeout)"
  interval="$(health_interval)"

  set_env_value MANTIS_IMAGE_REF "$immutable_ref" "$DEPLOY_ENV"
  set_env_value MANTIS_DEPLOYED_TAG "$tag" "$DEPLOY_ENV"

  compose up -d --no-deps --force-recreate "$SERVICE_NAME"

  if wait_for_health "$timeout" "$interval"; then
    return 0
  fi

  err "Container failed health/readiness check after ${timeout}s"
  compose logs --tail=100 "$SERVICE_NAME" >&2 || true
  return 1
}

record_success() {
  local tag="$1" immutable_ref="$2" old_tag="$3" old_ref="$4" old_contract="$5"

  if [[ -n "$old_tag" && -n "$old_ref" ]]; then
    write_state previous-tag "$old_tag"
    write_state previous-ref "$old_ref"
    if [[ -n "$old_contract" ]]; then
      write_state previous-contract "$old_contract"
    else
      remove_state previous-contract
    fi
  fi

  write_state current-tag "$tag"
  write_state current-ref "$immutable_ref"
  write_state current-contract "$DEPLOYMENT_CONTRACT_VERSION"
}

restore_previous_after_failure() {
  local old_tag="$1" old_ref="$2" old_contract="$3"

  if [[ -z "$old_tag" || -z "$old_ref" ]]; then
    err "No previous known-good deployment exists; stopping failed container"
    compose stop "$SERVICE_NAME" >/dev/null 2>&1 || true
    return 1
  fi

  # #98: never combine a previous image with the current Compose
  # lifecycle contract unless that image's own recorded contract is
  # known to match it. Starting it "to find out" is exactly the failure
  # mode this check exists to prevent (an old image entering a restart
  # loop under a `command`/healthcheck it doesn't support) -- so this
  # refuses *before* any docker pull/compose up for the previous image.
  if ! is_contract_compatible "$old_contract"; then
    err "Refusing automatic rollback to ${old_tag}: its recorded deployment contract (${old_contract:-unknown}) does not match the currently active contract (${DEPLOYMENT_CONTRACT_VERSION})."
    err "Starting it under the current compose.yaml could repeat exactly the incompatible-lifecycle failure this check exists to prevent (#98) -- refusing to attempt it automatically."
    err "Stopping the failed candidate container; current/previous deployment state is left unchanged."
    print_incompatible_rollback_recovery_hint "$old_tag" "$old_ref"
    emit_event rollback refused_incompatible_contract "$old_tag" "$old_ref"
    compose stop "$SERVICE_NAME" >/dev/null 2>&1 || true
    return 1
  fi

  log "Rolling back automatically to ${old_tag} (${old_ref})"
  docker pull "$old_ref" >/dev/null

  if apply_image "$old_tag" "$old_ref"; then
    write_state current-tag "$old_tag"
    write_state current-ref "$old_ref"
    write_state current-contract "$old_contract"
    emit_event rollback success "$old_tag" "$old_ref"
    log "Rollback succeeded"
    return 0
  fi

  emit_event rollback failure "$old_tag" "$old_ref"
  err "Rollback failed; manual intervention required"
  return 1
}

deploy_tag() {
  local tag="$1" repository tagged_ref immutable_ref old_tag old_ref old_contract
  validate_tag "$tag"
  repository="$(image_repository)"
  tagged_ref="${repository}:${tag}"
  old_tag="$(read_state current-tag || true)"
  old_ref="$(read_state current-ref || true)"
  old_contract="$(read_state current-contract || true)"

  log "Pulling ${tagged_ref}"
  docker pull "$tagged_ref"
  immutable_ref="$(resolve_digest_ref "$tagged_ref" "$repository")"
  log "Resolved ${tag} -> ${immutable_ref}"

  if ! apply_image "$tag" "$immutable_ref"; then
    emit_event deploy failure "$tag" "$immutable_ref"
    restore_previous_after_failure "$old_tag" "$old_ref" "$old_contract" || true
    return 1
  fi

  record_success "$tag" "$immutable_ref" "$old_tag" "$old_ref" "$old_contract"
  emit_event deploy success "$tag" "$immutable_ref"
  log "Deployed ${tag} (${immutable_ref})"
}

rollback() {
  local target_tag target_ref target_contract current_tag current_ref current_contract
  target_tag="$(read_state previous-tag || true)"
  target_ref="$(read_state previous-ref || true)"
  target_contract="$(read_state previous-contract || true)"
  current_tag="$(read_state current-tag || true)"
  current_ref="$(read_state current-ref || true)"
  current_contract="$(read_state current-contract || true)"

  [[ -n "$target_tag" && -n "$target_ref" ]] || die "No previous known-good deployment is recorded"

  # #98: the same compatibility gate as automatic rollback, and for the
  # same reason -- checked *before* any docker pull/compose up, so an
  # unsafe rollback never touches the currently running container at
  # all. Legacy state recorded before contract tracking existed has no
  # previous-contract file (empty here), which is_contract_compatible
  # treats as unknown, not compatible.
  if ! is_contract_compatible "$target_contract"; then
    err "Refusing rollback to ${target_tag}: its recorded deployment contract (${target_contract:-unknown}) does not match the currently active contract (${DEPLOYMENT_CONTRACT_VERSION})."
    err "Starting it under the current compose.yaml could repeat an incompatible-lifecycle failure (#98) rather than actually roll back safely."
    err "The currently running deployment (${current_tag:-unknown}) has NOT been touched."
    print_incompatible_rollback_recovery_hint "$target_tag" "$target_ref"
    emit_event rollback refused_incompatible_contract "$target_tag" "$target_ref"
    exit 1
  fi

  log "Rolling back ${current_tag:-unknown} -> ${target_tag}"
  docker pull "$target_ref" >/dev/null

  if ! apply_image "$target_tag" "$target_ref"; then
    emit_event rollback failure "$target_tag" "$target_ref"
    die "Rollback target failed health/readiness check; current state files were not changed"
  fi

  write_state current-tag "$target_tag"
  write_state current-ref "$target_ref"
  write_state current-contract "$target_contract"
  if [[ -n "$current_tag" && -n "$current_ref" ]]; then
    write_state previous-tag "$current_tag"
    write_state previous-ref "$current_ref"
    if [[ -n "$current_contract" ]]; then
      write_state previous-contract "$current_contract"
    else
      remove_state previous-contract
    fi
  else
    remove_state previous-tag
    remove_state previous-ref
    remove_state previous-contract
  fi

  emit_event rollback success "$target_tag" "$target_ref"
  log "Rollback complete: ${target_tag} (${target_ref})"
}

status() {
  local configured_tag configured_ref current_tag current_ref current_contract
  local previous_tag previous_ref previous_contract state health image image_id started
  configured_tag="$(read_env_value MANTIS_DEPLOYED_TAG "$DEPLOY_ENV" || true)"
  configured_ref="$(read_env_value MANTIS_IMAGE_REF "$DEPLOY_ENV" || true)"
  current_tag="$(read_state current-tag || true)"
  current_ref="$(read_state current-ref || true)"
  current_contract="$(read_state current-contract || true)"
  previous_tag="$(read_state previous-tag || true)"
  previous_ref="$(read_state previous-ref || true)"
  previous_contract="$(read_state previous-contract || true)"
  state="$(container_state)"
  health="$(container_health)"
  image="$(running_image_ref)"
  image_id="$(running_image_id)"
  started="$(docker inspect --format '{{.State.StartedAt}}' "$CONTAINER_NAME" 2>/dev/null || true)"

  cat <<EOF_STATUS
Configured tag:      ${configured_tag:-unknown}
Configured image:    ${configured_ref:-unknown}
Active contract:     ${DEPLOYMENT_CONTRACT_VERSION}
Current tag:         ${current_tag:-unknown}
Current image:       ${current_ref:-unknown}
Current contract:    ${current_contract:-unknown}
Previous tag:        ${previous_tag:-none}
Previous image:      ${previous_ref:-none}
Previous contract:   ${previous_contract:-unknown}
Running image:       ${image:-not running}
Running image ID:    ${image_id:-n/a}
Container state:     ${state:-not found}
Container health:    ${health:-n/a}
Started at:          ${started:-n/a}
EOF_STATUS
}

main() {
  local command="${1:-help}"

  case "$command" in
    -h|--help|help)
      usage
      return 0
      ;;
  esac

  ensure_layout

  exec 9>"$LOCK_FILE"
  flock -n 9 || die "Another mantis-deploy operation is already running"

  case "$command" in
    status) status ;;
    rollback) rollback ;;
    *)
      [[ $# -eq 1 ]] || die "Deploy accepts exactly one tag argument"
      deploy_tag "$command"
      ;;
  esac
}

main "$@"
