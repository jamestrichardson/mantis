# Local development environment template.
#
# Copy this to .env.local (git-ignored) to develop against our team's
# local dev AWX and LiteLLM endpoints:
#
#   cp .env.local.example .env.local
#
# Then fill in AWX_TOKEN and LITELLM_API_KEY with real values — never
# commit them. MANTIS_ENV defaults to "local", so .env.local is loaded
# automatically; no extra setup needed.

# ---------------------------------------------------------------------------
# LiteLLM / model gateway
# ---------------------------------------------------------------------------
LITELLM_URL=http://bespin.cosprings.teknofile.net:4000/v1
LITELLM_API_KEY=sk-changeme
LITELLM_MODEL=qwen3-opencode:latest

# ---------------------------------------------------------------------------
# AWX
# ---------------------------------------------------------------------------
AWX_URL=https://awx.cosprings.teknofile.net
AWX_TOKEN=changeme
AWX_VERIFY_SSL=true
