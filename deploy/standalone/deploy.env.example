# Deployment-only configuration for /opt/mantis/deploy.env.
# No application secrets belong in this file.

MANTIS_IMAGE_REPOSITORY=ghcr.io/jamestrichardson/mantis

# These are placeholders. `mantis-deploy <tag>` resolves the requested tag to
# an immutable digest and rewrites both values before starting the container.
MANTIS_IMAGE_REF=ghcr.io/jamestrichardson/mantis:__not_deployed__
MANTIS_DEPLOYED_TAG=__not_deployed__

# `mantis serve` (#21/#83) is the real persistent service and the image's
# own default command. Override only for deliberate one-off debugging
# (e.g. a shell) -- never as the normal operating mode.
MANTIS_CONTAINER_COMMAND="exec mantis serve"

# The deployment health gate polls this URL (via the container's Docker
# healthcheck) -- the real /readyz contract, not a synthetic substitute.
# In-container URL, since the healthcheck runs inside the container.
MANTIS_HEALTH_URL=http://127.0.0.1:8080/readyz

MANTIS_HEALTH_TIMEOUT_SECONDS=60
MANTIS_HEALTH_INTERVAL_SECONDS=2

# How long Docker waits after SIGTERM before SIGKILL-ing the container.
# Must stay comfortably above runtime.env's MANTIS_API_SHUTDOWN_GRACE_PERIOD_SECONDS
# (the application's own bounded drain window, default 30s) -- see
# docs/deployment.md's "Graceful shutdown" section. If you raise that
# value, raise this one to match (keep a buffer of at least 10s).
MANTIS_STOP_GRACE_PERIOD=40s
