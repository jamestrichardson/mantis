# Deployment-only configuration for /opt/mantis/deploy.env.
# No application secrets belong in this file.

MANTIS_IMAGE_REPOSITORY=ghcr.io/jamestrichardson/mantis

# These are placeholders. `mantis-deploy <tag>` resolves the requested tag to
# an immutable digest and rewrites both values before starting the container.
MANTIS_IMAGE_REF=ghcr.io/jamestrichardson/mantis:__not_deployed__
MANTIS_DEPLOYED_TAG=__not_deployed__

# Until Mantis has a long-running service command, keep the selected image
# resident for fast `docker compose exec mantis mantis ...` testing.
MANTIS_CONTAINER_COMMAND="exec sleep infinity"

# Leave blank while process-liveness is the health signal. The /metrics
# endpoint exists (#39) but isn't continuously served in this CLI-exec
# model, so it isn't a valid readiness signal yet. Once #66 gives Mantis
# a persistent service process holding /metrics open continuously, set
# this to the in-container URL, for example: http://127.0.0.1:9108/metrics
MANTIS_HEALTH_URL=

MANTIS_HEALTH_TIMEOUT_SECONDS=60
MANTIS_HEALTH_INTERVAL_SECONDS=2
