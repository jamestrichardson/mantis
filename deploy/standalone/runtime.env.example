# Runtime application configuration for /opt/mantis/runtime.env.
# Copy this file once, replace placeholders, and keep the real file mode 0600.
# These values are injected into the container by Docker Compose; they are not
# baked into an image or written to deployment state.

MANTIS_ENV=production

# LiteLLM / model gateway
LITELLM_URL=http://your-litellm-host:4000/v1
LITELLM_API_KEY=sk-changeme
LITELLM_MODEL=your-default-model-alias

# Optional per-agent model overrides (a minimal precursor to #16's full
# routing/escalation policy -- not that policy itself: no fallback,
# retry, or escalation across models happens here). Each is optional;
# LITELLM_MODEL above remains the fallback/default when unset. These
# are server-side model aliases/backend names only -- never
# caller-selectable through the API or CLI.
# MANTIS_AWX_TROUBLESHOOTER_MODEL=your-awx-troubleshooter-model-alias
# MANTIS_SYSTEM_TROUBLESHOOTER_MODEL=your-system-troubleshooter-model-alias

# AWX
AWX_URL=https://your-awx-host
AWX_TOKEN=changeme
AWX_VERIFY_SSL=true

# Git repository aliases (#17) -- git_recent_changes only ever inspects
# a repository through one of these server-side-configured aliases,
# never a model-supplied path. Each value is the path *as seen inside
# the container* -- see compose.yaml's `volumes:` section for mounting
# the host repository there **read-only** (`:ro`), since Mantis never
# needs (and must never have) write access to it.
# MANTIS_GIT_REPOSITORY_INFRA_CORE=/repos/infra-core

# Mantis API (#21/#83) -- the client-facing credential for this service,
# entirely separate from the server-side integration credentials above.
# Generate a random value, e.g.: openssl rand -hex 32
MANTIS_API_AUTH_MODE=bearer_token
MANTIS_API_TOKEN=changeme
# MANTIS_API_HOST=0.0.0.0
# MANTIS_API_PORT=8080
# MANTIS_API_MAX_CONCURRENT_RUNS=4
# MANTIS_API_SHUTDOWN_GRACE_PERIOD_SECONDS=30
