# Generic Mantis configuration template.
#
# Mantis loads local-dev environment files by name — see
# docs/configuration.md for the full convention. In short:
#
#   MANTIS_ENV=<name>   (defaults to "local")
#
# selects which file(s) get loaded, most specific first:
#   .env.<name>.local   (personal overrides, always git-ignored)
#   .env.<name>         (the named environment's settings, e.g. .env.local)
#   .env.local          (legacy/catch-all personal overrides)
#   .env                (shared, environment-agnostic defaults)
#
# A real deployment (EKS/GKE/ECS/Docker) injects environment variables
# directly and needs none of these files.
#
# For everyday local development, copy .env.local.example to .env.local
# instead of using this file directly — see that file for values already
# pointed at our team's local dev AWX/LiteLLM endpoints.
#
# Never commit a real .env* file — only *.example templates are tracked.

# ---------------------------------------------------------------------------
# LiteLLM / model gateway
# ---------------------------------------------------------------------------
# Base URL of your LiteLLM (or any OpenAI-compatible) gateway.
LITELLM_URL=http://localhost:4000/v1
# Virtual key issued by LiteLLM. Use a scoped key, not a raw provider key.
LITELLM_API_KEY=sk-changeme
# Model name as registered in LiteLLM. Optional — defaults to
# "qwen3-opencode:latest" if unset. This is the fallback/default used by
# any agent with no per-agent override set below.
LITELLM_MODEL=qwen3-opencode:latest
# Optional per-agent model overrides (a minimal precursor to #16's full
# routing/escalation policy) -- each falls back to LITELLM_MODEL above
# when unset. Server-side only, never caller-selectable through the API
# or CLI -- see docs/configuration.md#per-agent-model-overrides.
# MANTIS_AWX_TROUBLESHOOTER_MODEL=qwen3-opencode:latest
# MANTIS_SYSTEM_TROUBLESHOOTER_MODEL=qwen3-opencode:latest

# ---------------------------------------------------------------------------
# AWX
# ---------------------------------------------------------------------------
# Base URL of your AWX/AWX-compatible controller, no trailing slash.
AWX_URL=https://awx.example.internal
# A service-account token scoped to read-only access where possible.
AWX_TOKEN=changeme
# Verify TLS certificates when talking to AWX. Only disable for local testing.
AWX_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Mantis API (mantis serve / the CLI) -- see docs/api.md
# ---------------------------------------------------------------------------
# The client-facing credential the CLI/API share -- entirely separate from
# the integration credentials above. Make up your own value, e.g.:
# openssl rand -hex 32
MANTIS_API_TOKEN=changeme
